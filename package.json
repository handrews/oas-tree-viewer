{
  "name": "oas-tree-viewer",
  "version": "0.11.0",
  "description": "Visualize the parent/child structure of OpenAPI Description (OAD) documents as node-link trees.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "VITE_BENCH=1 vitest run --reporter=verbose bench",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "mcp": "npm run build:mcp && node dist-mcp/stdio.mjs",
    "mcp:http": "npm run build:mcp && node dist-mcp/http.mjs",
    "mcp:inspect": "npm run build:mcp && npx @modelcontextprotocol/inspector node dist-mcp/stdio.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@hyperjump/json-schema": "^1.18.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "d3": "^7.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0",
    "vitest-browser-svelte": "^3.1.0"
  }
}
